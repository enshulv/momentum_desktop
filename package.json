{
  "name": "momentum-desktop",
  "private": true,
  "version": "1.3.0",
  "description": "基于链式时延协议的自控力提升桌面应用",
  "author": "enshulv 基于 KenXiao1",
  "homepage": "https://github.com/enshulv/momentum_desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/enshulv/momentum_desktop.git"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --max-warnings 5000",
    "lint:strict": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env NODE_ENV=development vite dev\" \"wait-on http://localhost:8080 && cross-env NODE_ENV=development electron --experimental-specifier-resolution=node .\"",
    "electron:build": "vite build && electron-builder --publish always",
    "electron:build-only": "vite build && electron-builder --publish never",
    "security:check": "node scripts/security-check.js",
    "precommit": "npm run security:check && npm run lint",
    "postinstall": "node scripts/install-hooks.js",
    "build:win": "vite build && electron-builder --win --publish never",
    "build:zip": "vite build && electron-builder --win zip --publish never",
    "build:nsis": "vite build && electron-builder --win nsis --publish never",
    "build:nsis-only": "electron-builder --win nsis --publish never",
    "build:portable": "vite build && electron-builder --win portable --publish never",
    "build:portable-only": "electron-builder --win portable --publish never",
    "build:zip-only": "electron-builder --win zip --publish never",
    "build:sequential": "npm run clean && vite build && npm run build:nsis-only && npm run build:portable-only && npm run build:zip-only",
    "release:win": "vite build && electron-builder --win --publish always",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "clean": "rimraf dist out",
    "dist": "npm run clean && npm run build:sequential",
    "analyze": "cross-env ANALYZE=true vite build",
    "build:optimized": "npm run clean && npm run analyze && npm run build:sequential"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "archiver": "^7.0.1",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.344.0",
    "node-stream-zip": "^1.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.9.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cross-env": "^10.0.0",
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.35",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "semantic-release": "^24.2.7",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "update-electron-app": "^3.1.1",
    "vite": "^7.1.2",
    "vite-bundle-analyzer": "^0.11.0",
    "vitest": "^4.0.18",
    "wait-on": "^8.0.4"
  }
}
